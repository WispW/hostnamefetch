#!/usr/bin/env bash
# shellcheck disable=SC1090,SC2034
# SC1090: /etc/os-release is sourced from a dynamic path.
# SC2034: get_* outputs are read through ${!target} in info().
# vim: noai:ts=4:sw=4:expandtab
#
# hostnamefetch: a neofetch-style system information tool whose "logo" is a
# banner of your hostname.
#
# The system information gathering and the info/logo layout are inspired by
# and adapted from neofetch 7.1.0 (https://github.com/dylanaraps/neofetch),
# Copyright (c) 2015-2021 Dylan Araps, licensed under the MIT License.
# See the LICENSE file for the full license text.
#
# hostnamefetch is also licensed under the MIT License.

version="2026.11.21.1"

# Fallback for the edge case where BASH_VERSINFO is unavailable.
bash_version=${BASH_VERSINFO[0]:-0}

(( bash_version >= 4 )) || {
    printf '%s\n' "hostnamefetch: bash 4.0 or newer is required." >&2
    exit 1
}

# ---------------------------------------------------------------------------
# Defaults
# ---------------------------------------------------------------------------

banner=on
banner_text_override=""
banner_colors=(auto)
banner_chars=auto
banner_spacing=1
layout=auto
valign=center
gap=3

color_text=on
bold=on
title_fqdn=off
color_blocks=on
block_range=(0 15)
block_width=3
block_height=1
separator=":"
disable=()
stdout=off
os_arch=on

underline_char="-"

# Palette pairs used when --banner_colors is left on "auto". The pair is
# selected with a checksum of the hostname, so a given machine always gets
# the same colors.
banner_palettes=(
    "4 6"   # blue / cyan
    "6 4"   # cyan / blue
    "2 6"   # green / cyan
    "5 6"   # magenta / cyan
    "4 5"   # blue / magenta
    "3 4"   # yellow / blue
    "1 6"   # red / cyan
    "6 2"   # cyan / green
    "5 4"   # magenta / blue
    "3 6"   # yellow / cyan
    "2 4"   # green / blue
    "1 5"   # red / magenta
)

# ---------------------------------------------------------------------------
# Banner font
#
# A 5x5 block font. Glyphs are stored as five rows separated by "|", using
# "#" as the fill character. At render time "#" is replaced by the selected
# fill character (a full block or ASCII "#"). Every glyph is five columns
# wide, which makes layout and padding calculations trivial.
# ---------------------------------------------------------------------------

declare -A GLYPHS=()

GLYPHS["A"]=' ### |#   #|#####|#   #|#   #'
